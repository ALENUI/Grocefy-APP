# Copy to supabase/functions/.env for local development (`supabase start` / `supabase functions serve`).
# In production set these with `supabase secrets set NAME=value`.
EMAIL_WORKER_SECRET=local-worker-secret
EMAIL_PROVIDER=log
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Grocefy <notifications@your-domain.example>
APP_URL=grocefy://
PUSH_PROVIDER=log
