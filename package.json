{
  "name": "grocefy-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint --resolve-plugins-relative-to node_modules/eslint-config-expo --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test:db": "node scripts/test-db.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/services/database.types.ts",
    "test:services": "node scripts/test-services.cjs",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json",
    "test:email": "node scripts/test-email.cjs",
    "test:unit": "node scripts/test-unit.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~52.0.37",
    "expo-asset": "~11.0.5",
    "expo-constants": "~17.0.8",
    "expo-crypto": "~14.0.2",
    "expo-device": "~7.0.3",
    "expo-file-system": "~18.0.12",
    "expo-font": "~13.0.4",
    "expo-linking": "~7.0.5",
    "expo-notifications": "~0.29.14",
    "expo-router": "~4.0.17",
    "expo-sharing": "~13.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~8.0.1",
    "sucrase": "^3.35.1",
    "typescript": "~5.3.3"
  },
  "private": true
}
