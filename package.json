{
  "name": "grocefy-app",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc --noEmit",
    "test:db": "node scripts/test-db.mjs",
    "db:types": "supabase gen types typescript --linked --schema public > src/services/database.types.ts",
    "test:services": "node scripts/test-services.cjs",
    "typecheck:functions": "tsc -p supabase/functions/tsconfig.json",
    "test:email": "node scripts/test-email.cjs",
    "test:unit": "node scripts/test-unit.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@supabase/supabase-js": "^2.49.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.18",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "sucrase": "^3.35.1",
    "typescript": "~6.0.3"
  },
  "private": true
}
