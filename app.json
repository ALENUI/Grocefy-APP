{
  "expo": {
    "name": "Grocefy",
    "slug": "grocefy",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "scheme": "grocefy",
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-font",
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["armeabi-v7a", "arm64-v8a"],
            "useLegacyPackaging": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F3"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ToBuy",
              "label": "Grocefy · To buy",
              "description": "What is running low or finished at home, and how much is left to buy.",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "500dp",
              "maxResizeHeight": "500dp",
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.grocefy.app",
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22784B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.grocefy.app",
      "supportsTablet": true
    },
    "icon": "./assets/icon.png",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bba1d05f-d595-4b16-982f-708e6c9969ef"
      }
    },
    "owner": "alenui"
  }
}
